<?xml version="1.0" encoding="utf-8"?>
<!--
  كان البيان يحمل android:usesCleartextTraffic="true" — أي أن التطبيق يقبل
  HTTP على أي مضيف. وهو يحمل رمز دخول السائق في كل طلب، فشبكة واي فاي معادية
  تكفي لقراءته إن أمكن خفض الاتصال إلى نصّ صريح.

  الآن: HTTPS إلزامي في الإنتاج، والاستثناء محصور بعناوين التطوير المحلّية
  (10.0.2.2 هو مضيف الجهاز من داخل محاكي أندرويد).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
